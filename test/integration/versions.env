# Pinned versions for the integration network. This file is the only place they
# are set, and its hash names the binary cache, so a change here fetches again.
#
# The SHA-256 values are file checksums of the downloads. They have nothing to
# do with the chain, which is BLAKE2b.

KNOTS_VERSION=29.4.3.knots20260508
KNOTS_SHA256=4c67f1139b668fc3b98e339dd16112c636b2c0f42c2294b98fb92d1d27943e24

# lightning-fork has no Linux amd64 release asset, so the tag is built from
# source. LND_GO must match the go line of go.mod at that tag.
LND_REPO=https://github.com/paulscode/lightning-fork
LND_TAG=v0.21.6-beta-blake2b.23
LND_COMMIT=8a79a7b24b4a87a076429e8da509dfd38205fa53
LND_GO=go1.26.10
LND_TAGS=autopilotrpc chainrpc invoicesrpc peersrpc routerrpc signrpc walletrpc watchtowerrpc wtclientrpc

NAK_VERSION=v0.22.2
NAK_SHA256=1b81a772619d913f345ecc3d663edcd37e7548ea6b4e21c582bb3826e2604556

# Core Lightning from the privkeyio fork, which follows the BLAKE2b chain. Its
# releases carry Ubuntu builds and a SHA256SUMS file. The build must match the
# Ubuntu release it runs on, so each one used has its own checksum.
CLN_REPO=https://github.com/privkeyio/lightning
CLN_VERSION=v26.06.10-blake2b.1
CLN_SHA256_UBUNTU_24_04=06f915f0a3fd0e958c3efeac99117daf58af641f07f4129bc8676073b1ab185b
CLN_SHA256_UBUNTU_26_04=5297a32e77eb1280a1267dd2721a880cc18e24c933b0b2a6035bd318dcfd99ac
